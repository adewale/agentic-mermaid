C4Context
  title Customer checkout and payment services
  accTitle: Checkout system context
  accDescr: A customer places orders through the shop, which stores orders and requests payment from an external provider.
  Person(customer, "Customer", "Places and tracks orders")
  Enterprise_Boundary(company, "Shop company") {
    System(shop, "Online shop", "Coordinates checkout and order status")
    SystemDb(orders, "Order store", "Keeps accepted orders")
    SystemQueue(events, "Order events", "Publishes fulfillment work")
  }
  System_Ext(payments, "Payment provider", "Authorizes payment outside the company")
  Rel(customer, shop, "Places order", "HTTPS")
  Rel(shop, orders, "Stores order", "SQL")
  Rel(shop, events, "Publishes order", "AMQP")
  Rel(shop, payments, "Requests payment", "HTTPS")
  Rel_Back(shop, payments, "Returns authorization", "HTTPS")
  UpdateElementStyle(payments, $borderColor="#64748b")
