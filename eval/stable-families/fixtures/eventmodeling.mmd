eventmodeling
title Cart information flow
entity InitialItems
entity AddItem
entity ItemAdded
tf 01 ui Cart.UI
tf 02 cmd Cart.AddItem { description: string }
tf 03 evt Cart.ItemAdded
rf 04 evt Stock.Changed
tf 05 pcr Stock.Refresh
rf 06 rmo Cart.Items ->> 03 ->> 04 [[Items]]
tf 07 ui Cart.UI
data Items
`jsobj` {
count: 1
}
note 06 {
Show the latest cart items
}
gwt 06
given evt InitialItems
when cmd AddItem
then evt ItemAdded
