%% Wide nested headers must remain inside their ancestors (Mermaid issue #7901).
flowchart TB
  subgraph Outer[Outer]
    subgraph Mid[A nested heading much wider than its leaf nodes]
      entry[entry]
      subgraph Inner[Another heading wider than a and b]
        a[a] --> b[b]
      end
      done[done]
      entry --> Inner --> done
    end
  end
