classDiagram
direction TB
namespace Platform["Platform & API"] {
  class `class-namespace:Platform` {
    +String id
    +fetch()
  }
  class Store {
    +String state
    +save()
  }
  `class-namespace:Platform` --> Store : delegates
  namespace Domain["Domain records"] {
    class User {
      +UUID id
    }
    class Account {
      +UUID owner
    }
    User "1" o-- "many" Account : owns
  }
}
namespace Audit["Audit history"] {
  class Event {
    +String action
  }
  class Record {
    +String key
  }
  Event "1" --> "many" Record : logs
}
class Outside
Outside --() Protocol : uses
note for Store "Retain scoped note"
