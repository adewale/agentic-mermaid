{
  "name": "agentic-mermaid",
  "mcpName": "io.github.adewale/agentic-mermaid",
  "version": "0.4.2",
  "license": "MIT",
  "description": "Agentic Mermaid: render, verify, and safely edit Mermaid diagrams as ASCII, PNG, SVG, or structured agent workflows — with composable styles (hand-drawn, excalidraw, watercolor, or your own as JSON).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./agent/core": {
      "types": "./dist/agent-core.d.ts",
      "import": "./dist/agent-core.js",
      "default": "./dist/agent-core.js"
    },
    "./browser": "./dist/browser.global.js",
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "default": "./dist/svg.js"
    },
    "./svg/styles": {
      "types": "./dist/svg-styles.d.ts",
      "import": "./dist/svg-styles.js",
      "default": "./dist/svg-styles.js"
    },
    "./browser/lazy": {
      "types": "./dist/browser-lazy/index.d.ts",
      "import": "./dist/browser-lazy/index.js",
      "default": "./dist/browser-lazy/index.js"
    },
    "./style-spec.schema.json": "./docs/schemas/style-spec.schema.json",
    "./package.json": "./package.json",
    "./zenuml": {
      "types": "./dist/zenuml.d.ts",
      "import": "./dist/zenuml.js",
      "default": "./dist/zenuml.js"
    }
  },
  "unpkg": "./dist/browser.global.js",
  "jsdelivr": "./dist/browser.global.js",
  "imports": {
    "#elk-constructor": {
      "node": "./dist/elk-constructor.node.js",
      "default": "./dist/elk-constructor.js"
    }
  },
  "bin": {
    "am": "dist/am.js",
    "agentic-mermaid": "dist/am.js",
    "agentic-mermaid-mcp": "dist/agentic-mermaid-mcp.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adewale/agentic-mermaid.git"
  },
  "homepage": "https://agentic-mermaid.dev/",
  "bugs": {
    "url": "https://github.com/adewale/agentic-mermaid/issues"
  },
  "keywords": [
    "mermaid",
    "agentic-mermaid",
    "agent",
    "ai",
    "mcp",
    "cli",
    "diagram",
    "svg",
    "png",
    "ascii",
    "flowchart",
    "sequence-diagram",
    "class-diagram",
    "er-diagram",
    "timeline-diagram",
    "journey-diagram",
    "architecture-diagram",
    "xychart",
    "pie-chart",
    "quadrant-chart",
    "gantt-chart",
    "state-diagram",
    "mindmap",
    "git-graph",
    "radar-chart",
    "sankey-diagram",
    "c4-diagram",
    "packet-diagram",
    "kanban",
    "requirement-diagram",
    "treemap",
    "ishikawa",
    "block-diagram",
    "visualization",
    "theming",
    "styles",
    "hand-drawn",
    "sketch",
    "excalidraw",
    "watercolor",
    "llms-txt"
  ],
  "author": "Adewale",
  "files": [
    "dist/",
    "assets/fonts/",
    "assets/hero.png",
    "docs/*.md",
    "!docs/community-benchmark-ranking.md",
    "docs/schemas/style-spec.schema.json",
    "examples/styles/",
    "skills/",
    "AGENT_NATIVE.md",
    "Instructions_for_agents.md",
    "server.json",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "!dist/**/*.map",
    "!dist/metafile-esm.json"
  ],
  "scripts": {
    "test": "bun test --timeout 30000 src/__tests__/ eval/family-usage/count.test.ts eval/endpoint-marker/architecture-metrics.test.ts",
    "test:coverage": "bun run test -- --coverage",
    "typecheck": "bun run typecheck:core && bun run typecheck:repo",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:repo": "bun eval/trident/prepare.ts && tsc --noEmit -p tsconfig.repo.json",
    "quality:check": "bun run scripts/ci/quality-gates.ts",
    "generate": "bun run generate:sdk && bun run generate:browser-families && bun run doc-blocks && bun run agent-doc-artifacts && bun run style-spec-artifacts",
    "format": "biome format --write .",
    "format:changed": "biome format --write --changed",
    "test:browser": "bun run e2e/run-browser-contracts.ts",
    "editor": "bun run scripts/site/editor.ts",
    "dev": "bun run website:dev",
    "bench": "bun eval/benchmark/commands.ts bench",
    "bench:samples": "bun eval/benchmark/commands.ts bench:samples",
    "bench:dave": "bun eval/benchmark/commands.ts bench:dave",
    "bench:micro": "bun eval/benchmark/commands.ts bench:micro",
    "bench:experiments": "bun eval/benchmark/commands.ts bench:experiments",
    "bench:pipeline": "bun eval/benchmark/commands.ts bench:pipeline",
    "bench:peers": "bun eval/benchmark/commands.ts bench:peers",
    "bench:peers:qualify": "bun eval/benchmark/commands.ts bench:peers:qualify",
    "bench:release": "bun eval/benchmark/commands.ts bench:release",
    "bench:release:browser": "bun eval/benchmark/commands.ts bench:release:browser",
    "harvest:upstream": "bun run eval/mermaid-upstream-suite-bench/harvest.ts",
    "harvest:upstream:refresh-check": "bun run eval/mermaid-upstream-suite-bench/refresh-check.ts",
    "build": "bun run generate:sdk && tsup && bun run build:browser && bun run build:browser:lazy && bun run build:zenuml",
    "build:browser": "tsup --config tsup.browser.config.ts",
    "build:browser:lazy": "bun run scripts/build/clean-browser-lazy.ts && bun run generate:browser-families && tsup --config tsup.browser-lazy.config.ts",
    "check:browser-lazy": "bun run scripts/build/browser-lazy-report.ts",
    "generate:sdk": "bun run scripts/build/generate-sdk-declarations.ts",
    "generate:browser-families": "bun run scripts/build/generate-browser-family-catalog.ts",
    "check:browser-families": "bun run scripts/build/generate-browser-family-catalog.ts --check",
    "check:output-identity": "bun eval/benchmark/commands.ts check:output-identity",
    "build:binary": "bun build ./bin/am.ts --compile --outfile dist/am",
    "website": "bun run generate:sdk && bun run website/build.ts",
    "website:check": "bun run website/build.ts --check",
    "website:payload:check": "bun run scripts/site/website-payload-report.ts --check",
    "website:dev": "cd website && WRANGLER_SEND_METRICS=false ../node_modules/.bin/wrangler dev --local --host 127.0.0.1 --port 9095 --ip 127.0.0.1",
    "deploy": "gh workflow run deploy-cloudflare.yml --ref main",
    "prepublishOnly": "npm run build",
    "goldens:ascii": "bun run scripts/update-ascii-goldens.ts",
    "hero": "bun run scripts/site/hero.ts",
    "hero:check": "bun run scripts/site/hero.ts --check",
    "style:audit": "bun test --timeout 60000 src/__tests__/style-options.test.ts src/__tests__/styled-output.test.ts",
    "sketch:check": "bun test scripts/sketch-prototype/styles.test.ts && bun run scripts/sketch-prototype/contrast-audit.ts",
    "doc-blocks": "bun run scripts/generate-doc-blocks.ts",
    "agent-doc-artifacts": "bun run scripts/generate-agent-doc-artifacts.ts",
    "style-spec-artifacts": "bun run scripts/generate-style-spec-artifacts.ts",
    "upstream-family-index": "bun run scripts/generate-upstream-family-index.ts",
    "lint": "bun run lint:biome",
    "lint:biome": "biome lint .",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./browser",
    "eval:agent-live": "bun run eval/agent-usage/live.ts",
    "eval:agent-subagent": "bun run eval/agent-usage/capture-subagent-prompt-eval.ts",
    "eval:mcp-conformance": "bun run scripts/ci/mcp-conformance.ts",
    "eval:skill:hydrate": "bun run scripts/eval/hydrate-private-skill-evals.ts",
    "eval:skill:runner-manifest": "bun run scripts/eval/materialize-skill-runner-manifest.ts",
    "eval:skill:prepare-evidence": "bun run scripts/eval/prepare-skill-evidence.ts",
    "eval:skill:run-codex-evidence": "bun run scripts/eval/run-codex-evidence.ts",
    "eval:skill:bundle-evidence": "bun run scripts/eval/bundle-skill-evidence.ts",
    "eval:skill:materialize-codex-output": "bun run scripts/eval/materialize-codex-output.ts",
    "eval:skill:summarize-evidence": "bun run scripts/eval/summarize-skill-evidence.ts",
    "eval:family-portfolio": "bun run eval/mermaid-family-portfolio/build.ts",
    "eval:mermaid-assertions": "bun run eval/mermaid-upstream-assertions/run.ts",
    "eval:mermaid-modern": "bun run eval/mermaid-modern-compat/run.ts",
    "eval:mermaid-grammar": "bun run eval/mermaid-modern-compat/grammar-run.ts",
    "reference:mermaid": "bash scripts/setup-mermaid-reference.sh",
    "test:mermaid-modern": "bun test --timeout 30000 eval/mermaid-modern-compat/semantic.test.ts eval/mermaid-modern-compat/native-operations.test.ts eval/mermaid-modern-compat/grammar-regressions.test.ts",
    "eval:degenerate-routes": "bun run eval/degenerate-etn/enumerate.ts",
    "rubric:visual": "bun run eval/visual-rubric/run.ts",
    "contact:sheet": "bun run eval/visual-rubric/contact-sheet.ts",
    "gallery:custom-styles": "bun run scripts/docs/custom-style-cookbook.ts",
    "gallery:linkrank-feedback-packing": "bun run scripts/pr-assets/linkrank-feedback-packing-evidence.ts",
    "gallery:mindmap-gitgraph": "bun run scripts/pr-assets/mindmap-gitgraph-content-gallery.ts",
    "gallery:mermaid-docs": "bun run scripts/pr-assets/mermaid-doc-showcase-gallery.ts",
    "gallery:style-switch": "bun run scripts/pr-assets/style-switch-contact-sheet.ts",
    "gallery:pie-highlight": "bun run scripts/pr-assets/pie-highlightslice-evidence.ts",
    "gallery:sankey-comparison": "bun run scripts/pr-assets/sankey-mermaid-comparison.ts",
    "gallery:section-b": "bun run scripts/pr-assets/section-b-brand-evidence.ts",
    "track": "bun run eval/heuristic-tracker/run.ts",
    "audit:ugly": "bun run eval/ugly-detector/audit.ts",
    "audit:dependencies": "bun audit --audit-level=high",
    "bench:all": "bun eval/benchmark/commands.ts bench:all",
    "bench:families": "bun eval/benchmark/commands.ts bench:families",
    "bench:invocations": "bun eval/benchmark/commands.ts bench:invocations",
    "bench:community": "bun eval/benchmark/commands.ts bench:community",
    "bench:pinned-mermaid": "bun eval/benchmark/commands.ts bench:pinned-mermaid",
    "bench:prs": "bun eval/benchmark/commands.ts bench:prs",
    "bench:test": "bun eval/benchmark/commands.ts bench:test",
    "bench:typecheck": "bun eval/benchmark/commands.ts bench:typecheck",
    "bench:lint": "bun eval/benchmark/commands.ts bench:lint",
    "bench:community:update": "bun run eval/trident/run.ts community:update",
    "bench:portable": "bun run eval/trident/run.ts portable",
    "bench:portable:build": "bun run eval/trident/run.ts build",
    "bench:performance-profile": "bun eval/benchmark/commands.ts bench:performance-profile",
    "bench:endpoint-marker": "bun eval/benchmark/commands.ts bench:endpoint-marker",
    "bench:modern-summary": "bun eval/benchmark/commands.ts bench:modern-summary",
    "bench:corpus:export": "bun eval/benchmark/commands.ts corpus:export",
    "bench:results": "bun eval/trident/run.ts results:publish",
    "build:zenuml": "tsup --config tsup.zenuml.config.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "acorn": "8.16.0",
    "d3-format": "3.1.0",
    "d3-sankey": "0.12.3",
    "d3-shape": "1.3.7",
    "elkjs": "0.11.1",
    "entities": "^7.0.1",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "dompurify": "3.4.17",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.1",
    "hono": "4.13.13",
    "katex": "0.18.2",
    "lodash-es": "4.18.1",
    "picomatch": "4.0.5",
    "qs": "6.16.1",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.5",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@swc/core": "1.15.8",
    "@types/bun": "^1.3.9",
    "@types/d3-format": "3.0.4",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "1.3.12",
    "@zenuml/core": "3.47.9",
    "beautiful-mermaid": "1.1.3",
    "brotli": "1.3.3",
    "fast-check": "^4.6.0",
    "jsdom": "26.1.0",
    "mermaid": "12.2.0",
    "mermaid-ast": "0.8.2",
    "perfect-freehand": "1.2.3",
    "playwright": "^1.58.2",
    "publint": "0.3.24",
    "roughjs": "4.6.6",
    "saxes": "6.0.0",
    "shiki": "^3.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "upng-js": "^2.1.0",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
